.venv/
__pycache__/
.pytest_cache/
*.pyc

# Harvested answers are conversation data, not source.
.insane-review/

# Agent session state. It holds live SDK authority tokens, so it is never
# tracked: four commits had one in them before this rule existed.
.gjc/

# Generated by `lane engine sync` — the patch files are the source of truth.
# ~/.gitignore_global carries a bare `vendor/`, which silently kept the only
# copy of those patches on one disk: exactly the loss this layout exists to
# prevent. Re-include the directory, keep the generated engine out, track the
# patches.
!vendor/
vendor/*
!vendor/patches/
!vendor/patches/*.patch
