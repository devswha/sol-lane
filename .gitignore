.venv/
.smoke-venv/
dist/
.coverage
htmlcov/
requirements.txt

# The operator's own project registry — lane.toml.example is the tracked one.
lane.toml
__pycache__/
.pytest_cache/
*.pyc

# Harvested answers are conversation data, not source.
.insane-review/

# Agent session state. It holds live SDK authority tokens, so it is never
# tracked: four commits had one in them before this rule existed.
.gjc/

# The vendored engine is committed source now — this repo is its home. A bare
# `vendor/` in ~/.gitignore_global would silently keep the only copy on one
# disk, exactly the loss the old patch layout existed to prevent, so the
# directory and the engine are re-included here. Everything else under
# vendor/ stays generated.
!vendor/
vendor/*
!vendor/pack_and_ask.py
